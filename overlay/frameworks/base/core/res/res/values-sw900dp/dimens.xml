<resources>
    <!-- BoringdroidSystemUI renders a PC-style taskbar (app icons, clock,
         status chips) inside the NavigationBar. The stock sw900dp value of
         56dp is too cramped for this content; bump to 64dp so the taskbar
         has breathing room while still feeling like a system bar rather
         than a dock. -->
    <dimen name="navigation_bar_height">64dp</dimen>
    <dimen name="navigation_bar_height_landscape">64dp</dimen>
</resources>
